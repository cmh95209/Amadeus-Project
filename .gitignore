```gitignore
# =====================
# Python / Conda
# =====================
__pycache__/
*.pyc
*.pyo
*.pyd

.env
*.env
.venv/
venv/

# =====================
# Amadeus backend runtime data
# =====================
backend/__pycache__/
backend/unused_files/

# Secrets
backend/data/api_key.txt

# Persistent / generated runtime data
backend/data/memory.db
backend/data/memory.json
backend/data/stats.db
backend/data/active_conversation.txt
backend/data/web_access.txt
backend/data/deep_thinking.txt
backend/data/voice_retention.txt
backend/data/sampling.txt
backend/data/voice_ja.txt
backend/generated/
backend/ttsout/generated.wav
# Manual backup of the persona
backend/data/personality - Copy.txt
# Accidental runtime data created by running the app from the repo root
data/

# =====================
# Frontend / Node
# =====================
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Legacy WebUI folder name, if still present locally
Amadeus-WebUI/node_modules/
Amadeus-WebUI/dist/
Amadeus-WebUI/.vite/

# =====================
# Logs
# =====================
log_*.txt
*.log

# =====================
# GPT-SoVITS
# Large external dependency cloned separately
# =====================
GPT-SoVITS/

# =====================
# IDE / Editor
# =====================
.vscode/
.idea/

# =====================
# OS junk
# =====================
.DS_Store
Thumbs.db

# =====================
# Local-only files
# =====================
UsefulInfo/
.runtime/
# Manual .bak_* snapshots made while editing (never commit these)
*.bak_*
```
